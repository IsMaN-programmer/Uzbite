# Copy to .env at the workspace root. setup:local generates local secrets instead.
NODE_ENV=development
PORT=8081
DATABASE_URL=postgresql://uzbite:REPLACE_WITH_LOCAL_PASSWORD@127.0.0.1:5432/uzbite?schema=public
POSTGRES_PASSWORD=REPLACE_WITH_LOCAL_PASSWORD
REDIS_URL=redis://127.0.0.1:6379
JWT_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
JWT_REFRESH_SECRET=REPLACE_WITH_A_DIFFERENT_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Approximate delivery time: preparation + pickup + distance-based travel.
DELIVERY_AVERAGE_SPEED_KMH=18
DELIVERY_ROAD_FACTOR=1.35
DELIVERY_PICKUP_MINUTES=5
DELIVERY_ESTIMATE_MARGIN_MINUTES=10

# Optional S3-compatible provider. Receipts are private objects; avatars use CDN.
# Leave blank until a real bucket and credentials are configured.
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_PRIVATE_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
CDN_BASE_URL=

# Development seeding is disabled when NODE_ENV=production.
ALLOW_DEVELOPMENT_SEED=false
