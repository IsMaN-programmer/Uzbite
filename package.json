{
  "name": "uzbite",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:app": "concurrently -k -n api,web -c yellow,cyan \"npm run dev -w @uzbite/backend\" \"npm run dev -w @uzbite/frontend\"",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint apps packages prisma scripts tests --no-warn-ignored",
    "test": "tsx --test apps/backend/src/**/*.test.ts tests/unit/*.test.ts",
    "test:integration": "tsx --test tests/integration.test.ts",
    "test:dispatch": "tsx --test tests/dispatch.integration.test.ts",
    "test:courier": "tsx --test tests/courier.integration.test.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:local": "node scripts/local-postgres.mjs",
    "setup:local": "node scripts/setup-local.mjs",
    "order:status": "tsx apps/backend/src/scripts/order-status.ts",
    "restaurant:staff": "tsx apps/backend/src/scripts/restaurant-staff.ts",
    "courier:approve": "tsx apps/backend/src/scripts/courier-approve.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1164.0",
    "@aws-sdk/s3-request-presigner": "3.1164.0",
    "@prisma/client": "6.19.2",
    "@tanstack/react-query": "5.107.1",
    "axios": "1.21.0",
    "bcryptjs": "3.0.3",
    "cookie-parser": "1.4.7",
    "cors": "2.8.6",
    "dotenv": "17.4.2",
    "express": "5.3.0",
    "helmet": "8.3.0",
    "jsonwebtoken": "9.0.3",
    "multer": "2.5.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.5",
    "redis": "5.12.1",
    "socket.io": "4.8.4",
    "socket.io-client": "4.8.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@tailwindcss/vite": "4.3.5",
    "@types/cookie-parser": "1.4.10",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/jsonwebtoken": "9.0.10",
    "@types/multer": "2.3.0",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "concurrently": "9.2.5",
    "embedded-postgres": "18.6.0-beta.19",
    "eslint": "9.39.5",
    "globals": "16.5.0",
    "prisma": "6.19.2",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1"
  }
}

