{
  "name": "@uzbite/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "dev": "expo start --lan",
    "android": "expo start --android --lan",
    "web": "expo start --web --port 8082",
    "typecheck": "tsc --noEmit",
    "build": "expo export --platform android --output-dir dist --clear",
    "build:android": "node scripts/build-android.mjs",
    "build:android:eas": "eas build --platform android --profile preview",
    "build:android:bundle": "eas build --platform android --profile production"
  },
  "dependencies": {
    "@expo/metro-runtime": "58.0.17",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@react-navigation/bottom-tabs": "7.22.0",
    "@react-navigation/native": "7.5.2",
    "@react-navigation/native-stack": "7.21.1",
    "@tanstack/react-query": "5.107.1",
    "@uzbite/shared": "0.1.0",
    "axios": "1.21.0",
    "expo": "58.0.26",
    "expo-build-properties": "58.0.12",
    "expo-constants": "58.0.16",
    "expo-dev-client": "58.0.21",
    "expo-secure-store": "58.0.3",
    "expo-status-bar": "58.0.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "5.11.1",
    "react-native-screens": "4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "0.21.4",
    "socket.io-client": "4.8.4"
  }
}
