# Courier app (Expo). Copy to apps/mobile/.env; Expo inlines EXPO_PUBLIC_* at bundle time,
# so restart `npm run dev:mobile` after a change.

# Yandex Maps «JavaScript API и HTTP Геокодер» key from the Yandex developer console.
# Without it the restaurant map screen shows the same restaurants as a list.
EXPO_PUBLIC_YANDEX_MAPS_API_KEY=

# Address the in-app map page runs under (its HTTP Referer). If the key is restricted by
# HTTP Referer, allow this host there. Default: http://localhost/
# EXPO_PUBLIC_YANDEX_MAPS_REFERER=http://localhost/
