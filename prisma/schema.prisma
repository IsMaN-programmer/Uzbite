generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  RESTAURANT
  COURIER
}

enum OrderStatus {
  PENDING_ACCEPTANCE
  ACCEPTED
  PREPARING
  DELIVERING
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  CASH
  CARD
}

enum PaymentStatus {
  AWAITING_PAYMENT
  AWAITING_CONFIRMATION
  PAID
  REJECTED
}

enum MediaType {
  VIDEO
  IMAGE
}

enum UploadPurpose {
  AVATAR
  RECEIPT
}

/// Platform admission. Own-restaurant work is vouched for by an active affiliation;
/// free UzBite deliveries require APPROVED. SUSPENDED blocks every mode.
enum CourierApprovalStatus {
  PENDING
  APPROVED
  SUSPENDED
}

enum CourierWorkMode {
  RESTAURANT
  FREELANCE
}

enum AffiliationStatus {
  ACTIVE
  ENDED
}

enum CourierInvitationStatus {
  PENDING
  ACCEPTED
  REJECTED
  REVOKED
}

enum DeliveryMode {
  RESTAURANT_COURIER
  UZBITE_COURIER
}

enum DeliveryStatus {
  NOT_REQUESTED
  SEARCHING
  OFFERED
  ASSIGNED
  READY_FOR_PICKUP
  PICKED_UP
  ON_THE_WAY
  DELIVERED
  FAILED
  CANCELLED
}

enum DeliveryOfferStatus {
  PENDING
  ACCEPTED
  REJECTED
  EXPIRED
  WITHDRAWN
  TAKEN
}

enum CashCollectionStatus {
  NOT_APPLICABLE
  PENDING
  COLLECTED
  SETTLED
}

enum CourierRewardStatus {
  NONE
  ACCRUED
  CONFIRMED
  PAID
}

enum DeliveryIssueType {
  CANCELLATION_REQUEST
  HANDOFF_CODE_UNAVAILABLE
}

enum DeliveryIssueStatus {
  OPEN
  RESOLVED
}

model User {
  id                String         @id @default(cuid())
  email             String?        @unique
  passwordHash      String
  name              String
  username          String         @unique
  usernameChangedAt DateTime?
  bio               String         @default("")
  avatarUrl         String?
  recipientName     String?
  deliveryAddressId String?
  deliveryAddress   UserAddress?   @relation("DeliverySelection", fields: [deliveryAddressId], references: [id], onDelete: SetNull)
  phone             String?
  role              Role           @default(USER)
  tokenVersion      Int            @default(0)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  settings          UserSettings?
  addresses         UserAddress[]
  likes             Like[]
  comments          Comment[]
  follows           Follow[]
  reviews           Review[]
  orders            Order[]
  notifications     Notification[]
  uploads           Upload[]
  sessions          Session[]
  courierProfile    CourierProfile?
  restaurantStaff   RestaurantStaff?

  @@index([deliveryAddressId])
}

model Session {
  id          String   @id @default(cuid())
  userId      String
  refreshHash String
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model UserSettings {
  userId   String @id
  language String @default("ru")
  theme    String @default("light")
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserAddress {
  id          String   @id @default(cuid())
  userId      String
  latitude    Float
  longitude   Float
  addressText String
  label       String   @default("Дом")
  entrance    String   @default("")
  floor       String   @default("")
  apartment   String   @default("")
  comment     String   @default("")
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  selectedBy  User[]   @relation("DeliverySelection")

  @@index([userId])
}

model Restaurant {
  id                  String               @id @default(cuid())
  slug                String               @unique
  name                String
  description         String
  logoUrl             String
  coverUrl            String
  galleryUrls         String[]             @default([])
  addressText         String
  latitude            Float
  longitude           Float
  phone               String?
  telegram            String?
  isOpen              Boolean              @default(true)
  preparationMinutes  Int                  @default(20)
  deliveryFee         Decimal              @default(10000) @db.Decimal(14, 2)
  minOrder            Decimal              @default(20000) @db.Decimal(14, 2)
  paymentDetails      String?
  paymentQrUrl        String?
  paymentInstructions String?
  /// Courier matching uses the configured city/zone, not live courier GPS.
  city                String                         @default("tashkent")
  serviceZone         String?
  createdAt           DateTime                       @default(now())
  updatedAt           DateTime                       @updatedAt
  categories          RestaurantCategory[]
  dishes              Dish[]
  posts               Post[]
  follows             Follow[]
  reviews             Review[]
  orders              Order[]
  staff               RestaurantStaff[]
  courierAffiliations RestaurantCourierAffiliation[]
  courierInvitations  CourierInvitation[]
  deliveries          Delivery[]

  @@index([name])
}

model RestaurantCategory {
  id           String     @id @default(cuid())
  restaurantId String
  name         String
  sortOrder    Int        @default(0)
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  dishes       Dish[]

  @@unique([restaurantId, name])
}

model Dish {
  id           String             @id @default(cuid())
  restaurantId String
  categoryId   String
  name         String
  description  String
  price        Decimal            @db.Decimal(14, 2)
  imageUrl     String
  isAvailable  Boolean            @default(true)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  restaurant   Restaurant         @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  category     RestaurantCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  posts        Post[]
  orderItems   OrderItem[]

  @@index([restaurantId, isAvailable])
  @@index([name])
}

model Post {
  id           String      @id @default(cuid())
  restaurantId String
  dishId       String?
  caption      String
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  restaurant   Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  dish         Dish?       @relation(fields: [dishId], references: [id], onDelete: SetNull)
  media        PostMedia[]
  likes        Like[]
  comments     Comment[]

  @@index([createdAt])
  @@index([restaurantId, createdAt])
}

model PostMedia {
  id        String    @id @default(cuid())
  postId    String
  url       String
  posterUrl String?
  type      MediaType @default(VIDEO)
  duration  Float?
  width     Int?
  height    Int?
  size      Int?
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())
  post      Post      @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId, sortOrder])
}

model Like {
  userId    String
  postId    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@id([userId, postId])
  @@index([postId])
}

model Comment {
  id        String    @id @default(cuid())
  userId    String
  postId    String
  parentId  String?
  text      String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  parent    Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Comment[] @relation("CommentReplies")

  @@index([postId, createdAt])
  @@index([parentId])
}

model Follow {
  userId       String
  restaurantId String
  createdAt    DateTime   @default(now())
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@id([userId, restaurantId])
  @@index([restaurantId])
}

model Review {
  id           String     @id @default(cuid())
  orderId      String     @unique
  userId       String
  restaurantId String
  rating       Int
  text         String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  order        Order      @relation(fields: [orderId], references: [id], onDelete: Restrict)
  user         User       @relation(fields: [userId], references: [id], onDelete: Restrict)
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Restrict)

  @@index([restaurantId, createdAt])
}

model Order {
  id                String      @id @default(cuid())
  userId            String
  restaurantId      String
  restaurantName    String
  restaurantAddress String
  addressSnapshot   Json
  recipientName     String
  recipientPhone    String
  subtotal          Decimal     @db.Decimal(14, 2)
  deliveryFee       Decimal     @db.Decimal(14, 2)
  total             Decimal     @db.Decimal(14, 2)
  status            OrderStatus @default(PENDING_ACCEPTANCE)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  user              User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  restaurant        Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  items             OrderItem[]
  payment           Payment?
  review            Review?
  delivery          Delivery?

  @@index([userId, createdAt])
  @@index([restaurantId, status])
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  dishId    String?
  dishName  String
  unitPrice Decimal @db.Decimal(14, 2)
  quantity  Int
  imageUrl  String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  dish      Dish?   @relation(fields: [dishId], references: [id], onDelete: SetNull)

  @@index([orderId])
}

model Payment {
  id              String        @id @default(cuid())
  orderId         String        @unique
  method          PaymentMethod
  status          PaymentStatus @default(AWAITING_PAYMENT)
  receiptId       String?       @unique
  rejectionReason String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  order           Order         @relation(fields: [orderId], references: [id], onDelete: Restrict)
  receipt         Upload?       @relation(fields: [receiptId], references: [id], onDelete: Restrict)
}

model Upload {
  id        String        @id @default(cuid())
  userId    String
  key       String        @unique
  mimeType  String
  size      Int
  purpose   UploadPurpose
  createdAt DateTime      @default(now())
  user      User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  payment   Payment?

  @@index([userId, purpose])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  title     String
  body      String
  link      String
  metadata  Json?
  readAt    DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, readAt])
}

/// Links a RESTAURANT-role account to the restaurant it operates (Windows app staff).
model RestaurantStaff {
  userId       String     @id
  restaurantId String
  createdAt    DateTime   @default(now())
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
}

model CourierProfile {
  userId                String                         @id
  firstName             String
  lastName              String                         @default("")
  approvalStatus        CourierApprovalStatus          @default(PENDING)
  isTestAccount         Boolean                        @default(false)
  workMode              CourierWorkMode?
  isAvailable           Boolean                        @default(false)
  city                  String                         @default("tashkent")
  serviceZone           String?
  onboardingStep        Int                            @default(1)
  onboardingCompletedAt DateTime?
  createdAt             DateTime                       @default(now())
  updatedAt             DateTime                       @updatedAt
  user                  User                           @relation(fields: [userId], references: [id], onDelete: Cascade)
  affiliations          RestaurantCourierAffiliation[]
  invitations           CourierInvitation[]
  offers                DeliveryOffer[]
  deliveries            Delivery[]
  issues                DeliveryIssue[]

  @@index([workMode, isAvailable, approvalStatus, city])
}

/// Invitation codes are single-use and stored only as SHA-256 hashes.
model CourierInvitation {
  id           String                        @id @default(cuid())
  restaurantId String
  codeHash     String                        @unique
  status       CourierInvitationStatus       @default(PENDING)
  courierId    String?
  createdById  String?
  expiresAt    DateTime
  claimedAt    DateTime?
  respondedAt  DateTime?
  revokedAt    DateTime?
  createdAt    DateTime                      @default(now())
  restaurant   Restaurant                    @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  courier      CourierProfile?               @relation(fields: [courierId], references: [userId], onDelete: SetNull)
  affiliation  RestaurantCourierAffiliation?

  @@index([restaurantId, createdAt])
  @@index([courierId, status])
}

model RestaurantCourierAffiliation {
  id           String             @id @default(cuid())
  restaurantId String
  courierId    String
  invitationId String?            @unique
  status       AffiliationStatus  @default(ACTIVE)
  invitedAt    DateTime
  confirmedAt  DateTime           @default(now())
  endedAt      DateTime?
  endedBy      String?
  restaurant   Restaurant         @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  courier      CourierProfile     @relation(fields: [courierId], references: [userId], onDelete: Restrict)
  invitation   CourierInvitation? @relation(fields: [invitationId], references: [id], onDelete: SetNull)

  @@index([courierId, status])
  @@index([restaurantId, status])
}

/// One delivery per order. Order.status stays the customer-facing status;
/// Delivery.status is the courier/dispatch lifecycle.
model Delivery {
  id                String               @id @default(cuid())
  orderId           String               @unique
  restaurantId      String
  courierId         String?
  mode              DeliveryMode?
  status            DeliveryStatus       @default(NOT_REQUESTED)
  version           Int                  @default(0)
  reward            Decimal?             @db.Decimal(14, 2)
  rewardStatus      CourierRewardStatus  @default(NONE)
  pickupSnapshot    Json
  dropoffSnapshot   Json
  /// Shown only to the customer; the courier enters it at handoff.
  handoffCode       String
  handoffAttempts   Int                  @default(0)
  cashAmount        Decimal              @default(0) @db.Decimal(14, 2)
  cashStatus        CashCollectionStatus @default(NOT_APPLICABLE)
  cashCollectedAt   DateTime?
  cashCollectedById String?
  cashSettledAt     DateTime?
  searchStartedAt   DateTime?
  searchExpiresAt   DateTime?
  readyAt           DateTime?
  assignedAt        DateTime?
  pickedUpAt        DateTime?
  startedAt         DateTime?
  deliveredAt       DateTime?
  completedVia      String?
  closedAt          DateTime?
  closeReason       String?
  rewardConfirmedAt DateTime?
  rewardPaidAt      DateTime?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  order             Order                @relation(fields: [orderId], references: [id], onDelete: Restrict)
  restaurant        Restaurant           @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  courier           CourierProfile?      @relation(fields: [courierId], references: [userId], onDelete: Restrict)
  offers            DeliveryOffer[]
  events            DeliveryEvent[]
  issues            DeliveryIssue[]

  @@index([restaurantId, status])
  @@index([courierId, status])
  @@index([status, searchExpiresAt])
}

/// An offer is not an assignment: only an ACCEPTED offer confirmed by the server assigns a courier.
model DeliveryOffer {
  id            String              @id @default(cuid())
  deliveryId    String
  courierId     String
  mode          DeliveryMode
  status        DeliveryOfferStatus @default(PENDING)
  reward        Decimal?            @db.Decimal(14, 2)
  expiresAt     DateTime
  respondedAt   DateTime?
  rejectReason  String?
  releasedAt    DateTime?
  releaseReason String?
  createdAt     DateTime            @default(now())
  delivery      Delivery            @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  courier       CourierProfile      @relation(fields: [courierId], references: [userId], onDelete: Restrict)

  @@index([courierId, status, expiresAt])
  @@index([deliveryId, status])
}

/// Append-only audit trail of every dispatch transition.
model DeliveryEvent {
  id         String          @id @default(cuid())
  deliveryId String
  type       String
  fromStatus DeliveryStatus?
  toStatus   DeliveryStatus?
  actorId    String?
  actorRole  String
  offerId    String?
  reason     String?
  createdAt  DateTime        @default(now())
  delivery   Delivery        @relation(fields: [deliveryId], references: [id], onDelete: Cascade)

  @@index([deliveryId, createdAt])
}

/// Controlled procedure for problems after pickup and for missing handoff codes.
model DeliveryIssue {
  id             String              @id @default(cuid())
  deliveryId     String
  courierId      String
  type           DeliveryIssueType
  status         DeliveryIssueStatus @default(OPEN)
  reason         String
  resolution     String?
  resolutionNote String?
  resolvedById   String?
  resolvedAt     DateTime?
  createdAt      DateTime            @default(now())
  delivery       Delivery            @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  courier        CourierProfile      @relation(fields: [courierId], references: [userId], onDelete: Restrict)

  @@index([deliveryId, status])
}
